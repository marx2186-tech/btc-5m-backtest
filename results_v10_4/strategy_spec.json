      "reward_risk": 2.5,
      "max_holding_hours": 48
    },
    "short_persistence_age_relax": {
      "source": "short_persistence_baseline",
      "changed_condition_count": 1,
      "only_change": "trend_age_hours_range [8,120] -> [6,144]"
