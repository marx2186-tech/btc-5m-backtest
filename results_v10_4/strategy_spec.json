      "changed_condition_count": 2,
      "added_filters": [
        "price_extension_ema20_atr <= 1.20",
        "adx14 <= 45.0"
      ],
      "reason": "nested stricter comparison to test whether late-stage high-ADX long pullbacks should be removed",
      "stop_atr_multiple": 1.25,
      "reward_risk": 2.5,
      "max_holding_hours": 36
    },
    "short_persistence_baseline": {
